function git-move-last {
  git branch $1
  git reset --keep HEAD~1
  git checkout $1
}

function git-split-last {
  git reset HEAD~
}

function sysinfo {
  if command -v sensors >/dev/null 2>&1; then
    sensors | awk '
      /Tctl:|Tdie:/ {
        print "CPU:  " $2
        found=1
        exit
      }
      END { if (!found) print "CPU:  N/A" }
    '
  fi

  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=temperature.gpu \
      --format=csv,noheader,nounits |
      awk '{ print "GPU:  " $1 "°C" }'
  fi

  df -h --output=size,used,avail,pcent / | tail -n 1 |
    awk '{ printf "Disk: %s used / %s total (%s), %s free\n", $2, $1, $4, $3 }'
}

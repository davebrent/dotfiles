export EDITOR="nvim"

alias gs="git status"
alias gd="git diff"
alias gb="git branch"
alias gc="git checkout"
alias gg="git graph"
alias s="grep -Hrn"
alias d="ydiff -s"
alias tmux="tmux -2"
